<?xml version="1.0" encoding="utf-8"?>
<!--
  Based on SDL's own android-project template, cut down to what this game needs.

  The activity is SDL's, unmodified: org.libsdl.app.SDLActivity loads libSDL2.so and
  libmain.so and calls SDL_main. Naming our native module "main" is what buys that, and
  it is why this port contains no Java of its own.

  extractNativeLibs is true on purpose. The libraries then land as real files in
  nativeLibraryDir, which matters for the uncompressed-core variant: that is a directory
  where executable file mappings are permitted, and it is the only such place an app
  controls. See android/PLAN.md 7.2.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.thejach.descendant"
          android:versionCode="1"
          android:versionName="0.1">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="35" />

    <!-- The fast renderer's shader is GLSL ES 3.00. Declaring it keeps the game off
         devices whose driver could only fall back to the slow renderer. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application android:label="The Descendant"
                 android:icon="@mipmap/ic_launcher"
                 android:allowBackup="false"
                 android:hasCode="true"
                 android:extractNativeLibs="true">

        <activity android:name="org.libsdl.app.SDLActivity"
                  android:label="The Descendant"
                  android:exported="true"
                  android:launchMode="singleInstance"
                  android:screenOrientation="landscape"
                  android:preferMinimalPostProcessing="true"
                  android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
                  android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
